# ── SAP Business One SQL Server (read-only service account) ──────────────────
SAP_DB_HOST=sap-sqlserver.local
SAP_DB_PORT=1433
SAP_DB_NAME=SBO_COMPANY
SAP_DB_USER=bdx_readonly
SAP_DB_PASSWORD=CHANGE_ME
# TLS: "yes" enforces TLS, "no" disables (not recommended in production)
SAP_DB_TLS=yes
# TLS_CA_CERT: path to CA cert bundle for self-signed SQL Server certs
SAP_DB_TLS_CA_CERT=
# Connection and query timeouts in seconds
SAP_DB_CONNECT_TIMEOUT=10
SAP_DB_QUERY_TIMEOUT=30

# ── PostgreSQL (local event store) ───────────────────────────────────────────
POSTGRES_DSN=postgresql+psycopg2://bdx:bdx_local@localhost:5432/bdx_intelligence

# ── Collector behaviour ───────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60
RETRY_MAX_ATTEMPTS=5
RETRY_WAIT_MIN_SECONDS=2
RETRY_WAIT_MAX_SECONDS=60

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# "json" for structured production logs, "console" for human-readable dev logs
LOG_FORMAT=console
API_HOST=0.0.0.0
API_PORT=8080
