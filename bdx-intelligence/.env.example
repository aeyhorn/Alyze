# ═══════════════════════════════════════════════════════════════════════════════
# BDX Intelligence – Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── SAP Business One Service Layer (write channel, OData v4) ─────────────────
# Base URL without trailing slash
SL_BASE_URL=https://ldsap.leisinger.local:50000/b1s/v2
# Company databases per mode
SL_COMPANY_DB_DEV=DEV_SBO_LEISINGER
SL_COMPANY_DB_PROD=SBO_LEISINGER
# Fallback if Dev/Prod not set
SL_COMPANY_DB=DEV_SBO_LEISINGER
# SAP login credentials (read from env only – never commit)
SL_USERNAME=B1i
SL_PASSWORD=CHANGE_ME
# true only for internal self-signed certificates (LDSAP uses a self-signed cert)
SL_ALLOW_INVALID_CERT=true
# Per-request timeout in milliseconds.
# The Service Layer needs >30 s for the first login after being idle (cold start).
SL_TIMEOUT_MS=120000
# Set true to suppress all writes to SAP (GET and Login still work)
SL_DRY_RUN=false

# ── SAP mode (dev | prod) ─────────────────────────────────────────────────────
# Overridden by the value persisted in app_setting.sapMode (via PUT /api/v1/service-layer/mode)
SAP_MODE=dev

# ── SAP Business One SQL Server (read channel, MSSQL, read-only account) ─────
SAP_DB_HOST=ldsap.leisinger.local
SAP_DB_PORT=1433
# Database name follows SAP_MODE: dev → SL_COMPANY_DB_DEV, prod → SL_COMPANY_DB_PROD
# Set this to the same value as SL_COMPANY_DB_DEV initially
SAP_DB_NAME=DEV_SBO_LEISINGER
# "yes" = Windows integrated authentication (current domain user); USER/PASSWORD are then ignored.
# "no"  = SQL login below (requires the read-only login to exist on the SQL Server).
SAP_DB_TRUSTED_CONNECTION=no
SAP_DB_USER=bdx_readonly
SAP_DB_PASSWORD=CHANGE_ME
# TLS: "yes" enforces TLS (recommended), "no" disables
SAP_DB_TLS=yes
# Path to CA cert bundle for self-signed SQL Server certificates (optional)
SAP_DB_TLS_CA_CERT=
SAP_DB_CONNECT_TIMEOUT=10
SAP_DB_QUERY_TIMEOUT=30
# Installed ODBC driver name (check with: Get-OdbcDriver | ? Name -like "*SQL Server*")
SAP_DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# ── PostgreSQL (BDX event store) ──────────────────────────────────────────────
# Local Docker example: docker run -d --name bdx-intelligence-postgres -e POSTGRES_USER=bdx \
#   -e POSTGRES_PASSWORD=bdx_local -e POSTGRES_DB=bdx_intelligence -p 5432:5432 postgres:16-alpine
POSTGRES_DSN=postgresql+psycopg2://bdx:bdx_local@localhost:5432/bdx_intelligence

# ── Collector behaviour ───────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60
RETRY_MAX_ATTEMPTS=5
RETRY_WAIT_MIN_SECONDS=2
RETRY_WAIT_MAX_SECONDS=60

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# "json" for structured production logs, "console" for human-readable dev logs
LOG_FORMAT=console
API_HOST=0.0.0.0
API_PORT=8080
