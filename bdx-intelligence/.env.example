# ═══════════════════════════════════════════════════════════════════════════════
# BDX Intelligence – Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── SAP Business One Service Layer (write channel, OData v4) ─────────────────
# Base URL without trailing slash
SL_BASE_URL=https://ldsap.leisinger.local:50000/b1s/v2
# Company databases per mode
SL_COMPANY_DB_DEV=DEV_SBO_LEISINGER
SL_COMPANY_DB_PROD=SBO_LEISINGER
# Fallback if Dev/Prod not set
SL_COMPANY_DB=DEV_SBO_LEISINGER
# SAP login credentials (read from env only – never commit)
SL_USERNAME=B1i
SL_PASSWORD=CHANGE_ME
# true only for internal self-signed certificates (LDSAP uses a self-signed cert)
SL_ALLOW_INVALID_CERT=true
# Per-request timeout in milliseconds.
# The Service Layer needs >30 s for the first login after being idle (cold start).
SL_TIMEOUT_MS=120000
# Set true to suppress all writes to SAP (GET and Login still work)
SL_DRY_RUN=false

# ── SAP mode (dev | prod) ─────────────────────────────────────────────────────
# Overridden by the value persisted in app_setting.sapMode (via PUT /api/v1/service-layer/mode)
SAP_MODE=dev

# ── SAP Business One SQL Server (read channel, MSSQL, read-only account) ─────
SAP_DB_HOST=ldsap.leisinger.local
SAP_DB_PORT=1433
# Database name follows SAP_MODE: dev → SL_COMPANY_DB_DEV, prod → SL_COMPANY_DB_PROD
# Set this to the same value as SL_COMPANY_DB_DEV initially
SAP_DB_NAME=DEV_SBO_LEISINGER
# "yes" = Windows integrated authentication (current domain user); USER/PASSWORD are then ignored.
# "no"  = SQL login below (requires the read-only login to exist on the SQL Server).
SAP_DB_TRUSTED_CONNECTION=no
SAP_DB_USER=bdx_readonly
SAP_DB_PASSWORD=CHANGE_ME
# TLS: "yes" enforces TLS (recommended), "no" disables
SAP_DB_TLS=yes
# Path to CA cert bundle for self-signed SQL Server certificates (optional)
SAP_DB_TLS_CA_CERT=
SAP_DB_CONNECT_TIMEOUT=10
SAP_DB_QUERY_TIMEOUT=30
# Installed ODBC driver name (check with: Get-OdbcDriver | ? Name -like "*SQL Server*")
SAP_DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# ── PostgreSQL (BDX event store) ──────────────────────────────────────────────
# Local Docker example: docker run -d --name bdx-intelligence-postgres -e POSTGRES_USER=bdx \
#   -e POSTGRES_PASSWORD=bdx_local -e POSTGRES_DB=bdx_intelligence -p 5432:5432 postgres:16-alpine
POSTGRES_DSN=postgresql+psycopg2://bdx:bdx_local@localhost:5432/bdx_intelligence
# Separate event store for PROD mode (empty = reuse POSTGRES_DSN for both modes)
POSTGRES_DSN_PROD=

# ── Collector behaviour (SAP) ─────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60
RETRY_MAX_ATTEMPTS=5
RETRY_WAIT_MIN_SECONDS=2
RETRY_WAIT_MAX_SECONDS=60
# Incremental read: open orders (P/R) + orders created/updated since
# max(UpdateDate known to BDX) - INCREMENTAL_LOOKBACK_DAYS
INCREMENTAL_LOOKBACK_DAYS=2
# Force a full OWOR reload every N cycles (0 = only on first run / --full)
FULL_RELOAD_EVERY_CYCLES=0

# ── Machine feed (Mazak XmskSvr via SCADA nginx proxy; read-only) ────────────
MACHINE_ENABLED=true
# Direct XmskSvr (192.168.82.109:3202) answers 403 to other hosts → use the SCADA proxy
MACHINE_XMSK_URL=http://192.168.82.33:3888/api/machstates
MACHINE_POLL_INTERVAL_SECONDS=15
MACHINE_TIMEOUT_SECONDS=10
# Machine counts as offline when missing from the feed for this long
MACHINE_OFFLINE_AFTER_SECONDS=120

# ── BDE (derived from SCADA telemetry REST API; read-only) ───────────────────
BDE_ENABLED=true
BDE_SCADA_BASE_URL=http://192.168.82.33:3888
BDE_TIMEOUT_SECONDS=30
# Telemetry points of one order further apart than this start a new BDE record
BDE_GAP_SECONDS=900

# ── Event publishing (MQTT, optional – requires `pip install -e .[mqtt]`) ────
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=bdx-intelligence
# Topics: <prefix>/events/<EVENT_TYPE>/<source_key with ':' → '/'>
MQTT_TOPIC_PREFIX=bdx/intelligence
MQTT_QOS=1

# ── Event publishing (Kafka, optional alternative to MQTT – `pip install -e .[kafka]`) ─
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=bdx-intelligence-events
KAFKA_USERNAME=
KAFKA_PASSWORD=
# PLAINTEXT | SASL_PLAINTEXT | SASL_SSL | SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_CLIENT_ID=bdx-intelligence
# acks: 0 = fire-and-forget, 1 = leader, -1 = all ISR
KAFKA_ACKS=1
KAFKA_REQUEST_TIMEOUT=10

# ── bdx-quoter (Quote-to-Promise pricing / kalkulation) ───────────────────────
# Docker container typically publishes 8020. Leave ENABLED=false until reachable.
QUOTER_ENABLED=false
QUOTER_BASE_URL=http://192.168.82.33:8020
QUOTER_API_KEY=
QUOTER_TIMEOUT_SECONDS=120
# Override when web/server.py routes differ (client also tries aliases)
QUOTER_HEALTH_PATH=/api/health
QUOTER_RUN_PATH=/api/run
QUOTER_PROJEKT_PATH=/api/projekt

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# "json" for structured production logs, "console" for human-readable dev logs
LOG_FORMAT=console
API_HOST=0.0.0.0
# 8080 is taken by bdx-cam-frontend on the dev machine
API_PORT=8085
# Optional: protect /api/v1/* with an API key (X-API-Key header or ?api_key=). Empty = open.
API_KEY=
